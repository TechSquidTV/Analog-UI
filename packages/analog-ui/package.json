{
  "name": "analog-ui",
  "version": "0.0.0",
  "description": "Studio Hyper-Skeuomorphic React components for tactile controls with immersive lighting.",
  "keywords": [
    "analog-ui",
    "react",
    "tailwindcss",
    "shadcn",
    "shadcn-ui",
    "studio-hyper-skeuomorphic",
    "skeuomorphic",
    "components"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TechSquidTV/Analog-UI.git",
    "directory": "packages/analog-ui"
  },
  "bugs": {
    "url": "https://github.com/TechSquidTV/Analog-UI/issues"
  },
  "homepage": "https://analogui.com",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "components.json"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components/*": {
      "types": "./dist/registry/components/analog/*.d.ts",
      "import": "./dist/registry/components/analog/*.js"
    },
    "./hooks/*": {
      "types": "./dist/registry/hooks/*.d.ts",
      "import": "./dist/registry/hooks/*.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "import": "./dist/lib/*.js"
    },
    "./styles.css": "./dist/index.css",
    "./theme.css": "./dist/theme.css",
    "./components.css": "./dist/components.css",
    "./components.json": "./components.json"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts && node ./scripts/fix-esm-extensions.mjs && node ./scripts/copy-assets.mjs",
    "dev": "pnpm run build && tsup --watch --config tsup.config.ts --onSuccess \"node ./scripts/copy-assets.mjs\"",
    "perf:harness": "vite --config ./perf/vite.config.ts",
    "perf:ui": "playwright test --config ./playwright.perf.config.ts",
    "perf:ui:headed": "playwright test --config ./playwright.perf.config.ts --headed",
    "publish:check": "pnpm run build && node ./scripts/smoke-package.mjs && node ./scripts/check-package-size.mjs && node ./scripts/check-treeshaking.mjs",
    "smoke:package": "pnpm run build && node ./scripts/smoke-package.mjs",
    "size:package": "pnpm run build && node ./scripts/check-package-size.mjs",
    "treeshake": "pnpm run build && node ./scripts/check-treeshaking.mjs",
    "lint": "pnpm run lint:eslint && pnpm run typecheck",
    "lint:eslint": "pnpm exec eslint .",
    "registry:build": "shadcn build ./registry.json --output ../../apps/www/src/public/r",
    "knip": "pnpm -w exec knip --workspace analog-ui",
    "format": "pnpm exec prettier --write .",
    "format:check": "pnpm exec prettier --check .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.14"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.2.4",
    "@vitejs/plugin-react": "4.7.0",
    "esbuild": "^0.27.7",
    "shadcn": "^4.6.0",
    "tsup": "^8.3.5",
    "vite": "6.4.2"
  }
}
