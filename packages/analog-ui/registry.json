          "analog-surface-onyx-mid": "color-mix(in oklch, var(--card) 82%, black 10%)",
          "analog-surface-onyx-lo": "color-mix(in oklch, var(--background) 94%, black 8%)",
          "analog-shadow-depth": "1.05",
          "analog-grain-opacity": "0.28",
          "analog-foil-opacity": "0.22",
          "analog-bloom-strength": "0.62"
        }
