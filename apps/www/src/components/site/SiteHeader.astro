---
import SiteNavToggleGroup from './SiteNavToggleGroup';

interface Props {
  pathname: string;
}

const { pathname } = Astro.props;

const links = [
  { href: '/create', label: 'Create', width: '5.75rem' },
  { href: '/docs', label: 'Docs', width: '5rem' },
  { href: '/docs/components', label: 'Components', width: '7.75rem' },
];

const activeHref = links
  .filter((link) => pathname === link.href || pathname.startsWith(`${link.href}/`))
  .sort((left, right) => right.href.length - left.href.length)[0]?.href;
---

<header class="sticky top-0 z-50 border-b border-white/8 bg-[#060606]/82 backdrop-blur-xl">
  <div class="site-frame flex flex-wrap items-center justify-between gap-4 py-4">
    <a href="/" class="flex items-center gap-4">
      <span
        class="flex h-12 w-12 items-center justify-center rounded-[var(--analog-radius-panel)] border border-white/10 bg-white/[0.04] p-2 shadow-[0_16px_40px_rgba(0,0,0,0.32)]"
      >
        <img
          src="/img/logo/SVG/logo.svg"
          alt="Analog UI logo"
          class="h-full w-full rounded-[var(--analog-radius-shell)] object-cover"
        />
      </span>
      <span class="min-w-0">
        <span class="block text-lg font-semibold tracking-[-0.02em] text-white">Analog UI</span>
        <span class="block text-xs uppercase tracking-[0.26em] text-[#7d7d7d]">
          Studio Hyper-Skeuomorphism
        </span>
      </span>
    </a>

    <nav class="flex w-full justify-center sm:w-auto sm:justify-end">
      <SiteNavToggleGroup client:load links={links} activeHref={activeHref} />
    </nav>
  </div>
</header>
