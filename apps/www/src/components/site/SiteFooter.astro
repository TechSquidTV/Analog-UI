---
import { PushButton } from '../../../../../packages/analog-ui/src/index';
---

<footer class="border-t border-white/8">
  <div
    class="site-frame flex flex-col gap-4 py-10 text-sm text-[#8e8e8e] md:flex-row md:items-center md:justify-between"
  >
    <div>
      <div class="text-white">Analog UI</div>
      <div class="mt-1 max-w-xl text-[#8e8e8e]">
        Studio Hyper-Skeuomorphic components for tactile controls, machined panels, and analog
        lighting.
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <PushButton href="/docs" height="2.5rem" variant="black"> Read the docs </PushButton>
      <PushButton href="/docs/components" height="2.5rem" variant="black"> Components </PushButton>
      <PushButton href="/r/registry.json" height="2.5rem" variant="black">
        Registry JSON
      </PushButton>
    </div>
  </div>
</footer>
