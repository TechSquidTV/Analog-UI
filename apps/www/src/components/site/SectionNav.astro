---
interface NavLink {
  href: string;
  label: string;
}

interface Props {
  links: NavLink[];
  currentPath: string;
}

const { links, currentPath } = Astro.props;

const isActive = (href: string) =>
  href === '/blocks'
    ? currentPath === href
    : currentPath === href || currentPath.startsWith(`${href}/`);
---

<div class="section-panel p-3">
  <nav class="flex flex-wrap gap-2">
    {
      links.map((link) => (
        <a
          href={link.href}
          class:list={[
            'rounded-full border px-4 py-2 text-sm transition-colors duration-200',
            isActive(link.href)
              ? 'border-white/14 bg-white/[0.08] text-white'
              : 'border-white/8 bg-white/[0.02] text-[#b5b5b5] hover:border-white/14 hover:bg-white/[0.06] hover:text-white',
          ]}
        >
          {link.label}
        </a>
      ))
    }
  </nav>
</div>
