---
import { Code } from 'astro:components';
import DocsCopyButton from './DocsCopyButton';

type DocsCodeLang = 'tsx' | 'bash';
type DocsCodeTheme = 'github-dark';

interface Props {
  code: string;
  label?: string;
  lang?: DocsCodeLang;
  theme?: DocsCodeTheme;
  framed?: boolean;
  compact?: boolean;
  class?: string;
}

const {
  code,
  label = 'Code',
  lang = 'tsx',
  theme = 'github-dark',
  framed = true,
  compact = false,
  class: className,
} = Astro.props;
---

<div
  class:list={[
    'not-prose docs-code-block',
    framed && 'docs-code-block--framed',
    compact && 'docs-code-block--compact',
    className,
  ]}
  data-docs-copy-root
>
  <div class="docs-code-header">
    <span class="micro-label">{label}</span>
    <DocsCopyButton client:load />
  </div>
  <div class="docs-code-body" data-docs-code>
    <Code code={code} lang={lang} theme={theme} />
  </div>
</div>
