---
import { Code } from 'astro:components';

type DocsCodeLang = 'tsx' | 'bash';
type DocsCodeTheme = 'github-dark';

interface Props {
  code: string;
  label?: string;
  lang?: DocsCodeLang;
  theme?: DocsCodeTheme;
  framed?: boolean;
  class?: string;
}

const {
  code,
  label = 'Code',
  lang = 'tsx',
  theme = 'github-dark',
  framed = true,
  class: className,
} = Astro.props;
---

<div
  class:list={['not-prose docs-code-block', framed && 'docs-code-block--framed', className]}
  data-docs-copy-root
>
  <div class="docs-code-header">
    <span class="micro-label">{label}</span>
    <button type="button" class="docs-code-copy" data-docs-copy> Copy </button>
  </div>
  <div class="docs-code-body" data-docs-code>
    <Code code={code} lang={lang} theme={theme} />
  </div>
</div>
