---
interface BlockEntry {
  name: string;
  title: string;
  description: string;
  summary: string;
  categoryLabel: string;
  viewHref: string;
  registryHref: string;
}

interface Props {
  item: BlockEntry;
}

const { item } = Astro.props;
---

<section class="grid gap-8 xl:grid-cols-[minmax(0,0.82fr)_minmax(320px,0.98fr)] xl:items-start">
  <div class="space-y-5">
    <div class="eyebrow">{item.categoryLabel}</div>
    <div>
      <h2 class="text-3xl font-semibold tracking-[-0.03em] text-white md:text-4xl">{item.title}</h2>
      <p class="mt-3 max-w-xl text-lg leading-8 text-[#b5b5b5]">
        {item.summary}
      </p>
      <p class="mt-4 max-w-xl text-sm leading-7 text-[#878787]">
        {item.description}
      </p>
    </div>

    <div class="flex flex-wrap gap-3">
      <a class="pill-link" href={item.viewHref}>Open Preview</a>
      <a class="pill-link" href={item.registryHref}>Registry JSON</a>
    </div>

    <div class="section-panel p-4">
      <div class="micro-label">Install</div>
      <pre class="mt-3 overflow-x-auto text-xs text-[#e0e0e0]"><code>{`pnpm dlx shadcn@latest add https://analogui.com/r/analog-foundation.json
pnpm dlx shadcn@latest add https://analogui.com${item.registryHref}`}</code></pre>
    </div>
  </div>

  <div class="section-panel overflow-hidden p-4 md:p-6">
    <slot />
  </div>
</section>
