---
import { ClientRouter } from 'astro:transitions';
import SiteFooter from '../components/site/SiteFooter.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import '../styles/site.css';

interface Props {
  title?: string;
  description?: string;
}

const defaultDescription =
  'Studio Hyper-Skeuomorphic React components for tactile controls, machined panels, meters, and analog lighting. Built with Tailwind CSS and a shadcn-compatible registry.';

const { title = 'Analog UI', description = defaultDescription } = Astro.props;

const pageTitle =
  title === 'Analog UI'
    ? 'Analog UI - Studio Hyper-Skeuomorphic React Components'
    : `${title} | Analog UI`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/img/logo/SVG/logo.svg" />
    <link rel="icon" type="image/png" sizes="64x64" href="/img/logo/64w/logo.png" />
    <link rel="apple-touch-icon" sizes="256x256" href="/img/logo/256w/logo.png" />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonicalUrl} />
    <meta name="description" content={description} />
    <meta property="og:site_name" content="Analog UI" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <ClientRouter />
  </head>
  <body class="text-foreground antialiased selection:bg-white/10 selection:text-white">
    <div
      class="pointer-events-none fixed inset-0 bg-[radial-gradient(circle_at_top,rgba(255,255,255,0.04),transparent_34%)]"
    >
    </div>
    <div class="relative flex min-h-screen flex-col">
      <SiteHeader pathname={Astro.url.pathname} />
      <main class="flex-1 pb-20">
        <slot />
      </main>
      <SiteFooter />
    </div>
    <script>
      function bindDocsCopyButtons() {
        document.querySelectorAll<HTMLButtonElement>('[data-docs-copy]').forEach((button) => {
          if (button.dataset.docsCopyBound === 'true') return;

          button.dataset.docsCopyBound = 'true';
          const label = button.querySelector<HTMLElement>('[data-docs-copy-label]');
          const initialLabel = label?.textContent || button.textContent || 'Copy';
          const setLabel = (value: string) => {
            if (label) {
              label.textContent = value;
            } else {
              button.textContent = value;
            }
          };

          button.addEventListener('click', async () => {
            const root = button.closest('[data-docs-copy-root]');
            const code = root?.querySelector<HTMLElement>('[data-docs-code]');
            const text = code?.textContent?.trimEnd() ?? '';

            if (!navigator.clipboard) {
              setLabel('Unavailable');
              window.setTimeout(() => {
                setLabel(initialLabel);
              }, 1400);
              return;
            }

            try {
              await navigator.clipboard.writeText(text);
              setLabel('Copied');
            } catch {
              setLabel('Failed');
            }

            window.setTimeout(() => {
              setLabel(initialLabel);
            }, 1400);
          });
        });
      }

      bindDocsCopyButtons();
      document.addEventListener('astro:page-load', bindDocsCopyButtons);
    </script>
  </body>
</html>
