---
import BlockDemo from "../../components/blocks/BlockDemo";
import BlockShowcase from "../../components/blocks/BlockShowcase.astro";
import SectionNav from "../../components/site/SectionNav.astro";
import { blockCategories, type BlockCategory } from "../../data/block-catalog";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getBlockEntries } from "../../lib/blocks";

export function getStaticPaths() {
  return Object.keys(blockCategories).map((category) => ({
    params: { category },
  }));
}

const category = Astro.params.category as BlockCategory;
const categoryMeta = blockCategories[category];
const blocks = getBlockEntries(category);

const navLinks = [
  { href: "/blocks", label: "Featured" },
  ...Object.entries(blockCategories).map(([slug, meta]) => ({
    href: `/blocks/${slug}`,
    label: meta.label,
  })),
];
---

<SiteLayout title={`${categoryMeta.label} Blocks`} description={categoryMeta.description}>
  <section class="site-frame pt-10 md:pt-12">
    <div class="max-w-3xl">
      <div class="eyebrow mb-4">{categoryMeta.label}</div>
      <h1 class="text-4xl font-semibold tracking-[-0.03em] text-white md:text-5xl">
        {categoryMeta.description}
      </h1>
      <p class="mt-4 text-lg leading-8 text-[#a8a8a8]">
        Each entry keeps the preview, install path, and registry JSON in one place so the browsing
        surface is useful for both design review and implementation.
      </p>
    </div>

    <div class="mt-8">
      <SectionNav links={navLinks} currentPath={`/blocks/${category}`} />
    </div>

    <div class="mt-10 space-y-14">
      {
        blocks.map((block) => (
          <BlockShowcase item={block}>
            <BlockDemo name={block.name} mode="full" client:load />
          </BlockShowcase>
        ))
      }
    </div>
  </section>
</SiteLayout>
