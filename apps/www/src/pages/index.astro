---
import HomeVstSurface from '../components/home/HomeVstSurface';
import { getFeaturedBlocks } from '../lib/blocks';
import { getRegistryItems } from '../lib/registry';
import SiteLayout from '../layouts/SiteLayout.astro';

const featuredBlocks = getFeaturedBlocks(4);
const registryUiCount = getRegistryItems().filter((item) => item.type === 'registry:ui').length;
---

<SiteLayout
  title="Analog UI"
  description="A tactile component library and registry for studio-grade interfaces with analog lighting and machined surfaces."
>
  <section class="site-frame pt-10 md:pt-16">
    <div class="grid gap-8 lg:grid-cols-[1.08fr_0.92fr]">
      <div class="max-w-3xl">
        <div class="eyebrow mb-5">Tactile Interface System</div>
        <h1 class="text-5xl font-semibold tracking-[-0.05em] text-white md:text-7xl">
          UI you can
          <span class="block text-[var(--color-accent)] italic">feel.</span>
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-[#afafaf] md:text-xl">
          Analog UI brings studio hyper-skeuomorphism to the web: machined knobs, dense rack panels,
          jewel lamps, trim wheels, and a shared lighting model that makes surfaces react like
          hardware.
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a class="pill-link" href="/docs">Read the docs</a>
          <a class="pill-link" href="/blocks">Browse blocks</a>
          <a class="pill-link" href="/r/registry.json">Registry JSON</a>
        </div>
      </div>

      <div class="section-panel p-6">
        <div class="eyebrow mb-4">Launch Surface</div>
        <div class="grid gap-4 md:grid-cols-3">
          <div class="rounded-2xl border border-white/10 bg-black/30 p-4">
            <div class="micro-label">UI Items</div>
            <div class="mt-2 text-3xl font-semibold text-white">{registryUiCount}</div>
          </div>
          <div class="rounded-2xl border border-white/10 bg-black/30 p-4">
            <div class="micro-label">Featured Blocks</div>
            <div class="mt-2 text-3xl font-semibold text-white">{featuredBlocks.length}</div>
          </div>
          <div class="rounded-2xl border border-white/10 bg-black/30 p-4">
            <div class="micro-label">Registry Feed</div>
            <div class="mt-2 text-3xl font-semibold text-white">/r</div>
          </div>
        </div>

        <div class="mt-6 rounded-[24px] border border-white/10 bg-black/35 p-4">
          <div class="micro-label">First Install</div>
          <pre
            class="mt-3 overflow-x-auto text-xs text-[#e6e6e6]"><code>{`pnpm dlx shadcn@latest add https://analogui.com/r/analog-foundation.json
pnpm dlx shadcn@latest add https://analogui.com/r/dial.json`}</code></pre>
        </div>
      </div>
    </div>
  </section>

  <section class="site-frame mt-8 grid gap-4 md:grid-cols-3">
    <a href="/docs" class="section-panel p-5 transition-colors duration-200 hover:bg-white/[0.05]">
      <div class="eyebrow">Docs</div>
      <h2 class="mt-3 text-2xl font-semibold text-white">Installation, tokens, and usage</h2>
      <p class="mt-3 text-sm leading-7 text-[#959595]">
        Start with the package path, registry flow, and lighting model before you copy controls into
        a host app.
      </p>
    </a>

    <a
      href="/blocks"
      class="section-panel p-5 transition-colors duration-200 hover:bg-white/[0.05]"
    >
      <div class="eyebrow">Blocks</div>
      <h2 class="mt-3 text-2xl font-semibold text-white">Preview the families</h2>
      <p class="mt-3 text-sm leading-7 text-[#959595]">
        Browse inputs, readouts, and surfaces with dedicated pages, install snippets, and isolated
        previews.
      </p>
    </a>

    <a
      href="/view/panel"
      class="section-panel p-5 transition-colors duration-200 hover:bg-white/[0.05]"
    >
      <div class="eyebrow">Preview</div>
      <h2 class="mt-3 text-2xl font-semibold text-white">Review one block at a time</h2>
      <p class="mt-3 text-sm leading-7 text-[#959595]">
        Use the isolated preview routes for focused QA, screenshots, and screenshot-friendly
        staging.
      </p>
    </a>
  </section>

  <section class="site-frame mt-16">
    <div class="max-w-3xl">
      <div class="eyebrow mb-4">Featured Surface</div>
      <h2 class="text-4xl font-semibold tracking-[-0.04em] text-white">
        A fake plugin built from the whole shelf.
      </h2>
      <p class="mt-4 text-lg leading-8 text-[#a8a8a8]">
        The guided landing now resolves into one stitched-together VST-style interface so visitors
        can see the catalog behaving like real hardware instead of isolated tiles.
      </p>
    </div>

    <div class="mt-8">
      <HomeVstSurface client:load />
    </div>
  </section>
</SiteLayout>
