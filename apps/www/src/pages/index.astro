---
import HomeLaunchPanel from '../components/home/HomeLaunchPanel';
import HomeRouteCards from '../components/home/HomeRouteCards';
import HomeVstSurface from '../components/home/HomeVstSurface';
import { getFeaturedBlocks } from '../lib/blocks';
import { getRegistryItems } from '../lib/registry';
import SiteLayout from '../layouts/SiteLayout.astro';

const featuredBlocks = getFeaturedBlocks(4);
const registryUiCount = getRegistryItems().filter((item) => item.type === 'registry:ui').length;
---

<SiteLayout
  title="Analog UI"
  description="A tactile component library and registry for studio-grade interfaces with analog lighting and machined surfaces."
>
  <section class="site-frame pt-10 md:pt-16">
    <div class="grid gap-8 lg:grid-cols-[1.08fr_0.92fr]">
      <div class="max-w-3xl">
        <div class="eyebrow mb-5">Tactile Interface System</div>
        <h1 class="text-5xl font-semibold tracking-[-0.05em] text-white md:text-7xl">
          UI you can
          <span class="block text-[var(--color-accent)] italic">feel.</span>
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-[#afafaf] md:text-xl">
          Analog UI brings studio hyper-skeuomorphism to the web: machined knobs, dense rack panels,
          jewel lamps, trim wheels, and a shared lighting model that makes surfaces react like
          hardware.
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a class="pill-link" href="/docs">Get Started</a>
          <a class="pill-link" href="/docs/components">View Components</a>
          <a class="pill-link" href="/blocks">Browse Blocks</a>
        </div>
      </div>

      <HomeLaunchPanel
        featuredBlocksCount={featuredBlocks.length}
        registryUiCount={registryUiCount}
      />
    </div>
  </section>

  <section class="site-frame mt-8">
    <HomeRouteCards />
  </section>

  <section class="site-frame mt-16">
    <div class="max-w-3xl">
      <div class="eyebrow mb-4">Featured Surface</div>
      <h2 class="text-4xl font-semibold tracking-[-0.04em] text-white">
        A fake plugin built from the whole shelf.
      </h2>
      <p class="mt-4 text-lg leading-8 text-[#a8a8a8]">
        The guided landing now resolves into one stitched-together VST-style interface so visitors
        can see the catalog behaving like real hardware instead of isolated tiles.
      </p>
    </div>

    <div class="mt-8">
      <HomeVstSurface client:load />
    </div>
  </section>
</SiteLayout>
