---
import BlockDemo from '../../../components/blocks/BlockDemo';
import ComponentPreview from '../../../components/docs/ComponentPreview.astro';
import DocsCodeBlock from '../../../components/docs/DocsCodeBlock.astro';
import { getComponentPageDoc } from '../../../data/component-docs';
import DocsLayout from '../../../layouts/DocsLayout.astro';
import { getBlockEntries, getBlockEntry } from '../../../lib/blocks';
import { getComponentDocHref, getDocsNavigation } from '../../../lib/docs';

function slugify(value: string) {
  return value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
}

export function getStaticPaths() {
  return getBlockEntries().map((entry) => ({
    params: { name: entry.name },
  }));
}

const entry = getBlockEntry(Astro.params.name ?? '');

if (!entry) {
  throw new Error(`Missing component docs entry for "${Astro.params.name}".`);
}

const navigation = await getDocsNavigation();
const componentDoc = getComponentPageDoc(entry.name);
const headings = [
  { depth: 2, slug: 'example', text: 'Example' },
  { depth: 2, slug: 'installation', text: 'Installation' },
  { depth: 2, slug: 'usage', text: 'Usage' },
  { depth: 2, slug: 'api-reference', text: 'API Reference' },
  ...componentDoc.api.map((section) => ({
    depth: 3,
    slug: slugify(section.title),
    text: section.title,
  })),
];
const registryInstallSnippet = `pnpm dlx shadcn@latest add https://analogui.com/r/analog-foundation.json
pnpm dlx shadcn@latest add https://analogui.com${entry.registryHref}`;
const packageInstallSnippet = `pnpm add analog-ui`;
---

<DocsLayout
  title={entry.title}
  description={entry.description}
  currentPath={getComponentDocHref(entry.name)}
  navigation={navigation}
  headings={headings}
>
  <p>{entry.summary}</p>
  <p>
    {entry.description}
    {' '}
    Use the example first, then keep going for install commands, copyable usage, and API notes.
  </p>

  <h2 id="example">Example</h2>
  <p>
    The preview below renders the component in the Analog UI demo surface. Copy the source to start
    from a smaller standalone example in your own app.
  </p>

  <ComponentPreview
    code={componentDoc.exampleCode}
    title={`${entry.title} Example`}
    description="Interactive preview with copyable source."
    codeLabel="Source"
  >
    <BlockDemo slot="preview" name={entry.name} mode="full" client:load />
  </ComponentPreview>

  <div class="not-prose mt-6 flex flex-wrap gap-3">
    <a class="pill-link" href="/docs/components">All Components</a>
    <a class="pill-link" href={entry.viewHref}> Open Isolated Preview </a>
  </div>

  <h2 id="installation">Installation</h2>
  <p>
    Install the shared foundation first so the material tokens and analog lighting variables are in
    place, then add this component from the shadcn-compatible registry.
  </p>

  <h3>Registry</h3>
  <DocsCodeBlock code={registryInstallSnippet} label="Terminal" lang="bash" />

  {
    componentDoc.packageImportCode ? (
      <>
        <h3>Package</h3>
        <p>
          If you prefer the package instead of copied source, install the package and import the
          shared stylesheet once in your app.
        </p>
        <DocsCodeBlock code={packageInstallSnippet} label="Terminal" lang="bash" />
      </>
    ) : (
      <blockquote>
        This surface is documented through the registry flow. It is intended as a compositional
        primitive and is not currently re-exported from the package entrypoint.
      </blockquote>
    )
  }

  <h2 id="usage">Usage</h2>
  <p>{componentDoc.usageIntro}</p>

  <h3>Registry import</h3>
  <DocsCodeBlock code={componentDoc.registryImportCode} label="Code" />

  {
    componentDoc.packageImportCode ? (
      <>
        <h3>Package import</h3>
        <DocsCodeBlock code={componentDoc.packageImportCode} label="Code" />
      </>
    ) : null
  }

  <h3>Basic usage</h3>
  <DocsCodeBlock code={componentDoc.usageCode} label="Code" />

  <h2 id="api-reference">API Reference</h2>
  <p>
    These tables focus on Analog UI-specific props. Components that wrap Base UI primitives also
    inherit the relevant native and Base UI props for that primitive.
  </p>

  {
    componentDoc.api.map((section) => (
      <>
        <h3 id={slugify(section.title)}>{section.title}</h3>
        <p>{section.description}</p>
        <div class="not-prose mt-4 overflow-x-auto rounded-[var(--analog-radius-shell)] border border-white/10 bg-black/30">
          <table class="w-full min-w-[720px] border-collapse text-left text-sm">
            <thead>
              <tr class="border-b border-white/10 text-[11px] uppercase tracking-[0.2em] text-[#8a8a8a]">
                <th class="px-4 py-3 font-semibold">Prop</th>
                <th class="px-4 py-3 font-semibold">Type</th>
                <th class="px-4 py-3 font-semibold">Default</th>
                <th class="px-4 py-3 font-semibold">Description</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/8">
              {section.props.map((prop) => (
                <tr>
                  <td class="px-4 py-3 align-top font-mono text-[13px] text-white">{prop.name}</td>
                  <td class="px-4 py-3 align-top font-mono text-[13px] text-[#d9d9d9]">
                    {prop.type}
                  </td>
                  <td class="px-4 py-3 align-top font-mono text-[13px] text-[#a8a8a8]">
                    {prop.defaultValue ?? '-'}
                  </td>
                  <td class="px-4 py-3 align-top text-[#b9b9b9]">{prop.description}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    ))
  }

  <h3 id="registry-metadata">Registry metadata</h3>
  <p>
    The registry item records package and registry dependencies so copied-source installs remain
    reproducible.
  </p>

  <div class="not-prose mt-6 grid gap-4 md:grid-cols-2">
    <div class="rounded-[var(--analog-radius-shell)] border border-white/10 bg-black/30 p-4">
      <div class="micro-label">Registry Dependencies</div>
      <div class="mt-4 flex flex-wrap gap-2">
        {
          entry.registryDependencies.length > 0 ? (
            entry.registryDependencies.map((dependency) => (
              <span class="rounded-full border border-white/10 bg-white/[0.04] px-3 py-1 text-xs text-[#d6d6d6]">
                {dependency}
              </span>
            ))
          ) : (
            <span class="text-sm text-[#7c7c7c]">None</span>
          )
        }
      </div>
    </div>
    <div class="rounded-[var(--analog-radius-shell)] border border-white/10 bg-black/30 p-4">
      <div class="micro-label">Package Dependencies</div>
      <div class="mt-4 flex flex-wrap gap-2">
        {
          entry.dependencies.length > 0 ? (
            entry.dependencies.map((dependency) => (
              <span class="rounded-full border border-white/10 bg-white/[0.04] px-3 py-1 text-xs text-[#d6d6d6]">
                {dependency}
              </span>
            ))
          ) : (
            <span class="text-sm text-[#7c7c7c]">None</span>
          )
        }
      </div>
    </div>
  </div>
</DocsLayout>
