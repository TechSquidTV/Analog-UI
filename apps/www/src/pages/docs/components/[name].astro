---
import BlockDemo from '../../../components/blocks/BlockDemo';
import type { BlockName } from '../../../data/block-catalog';
import DocsLayout from '../../../layouts/DocsLayout.astro';
import { getBlockEntries, getBlockEntry } from '../../../lib/blocks';
import { getComponentDocHref, getDocsNavigation } from '../../../lib/docs';

function toPascalCase(value: string) {
  return value
    .split('-')
    .map((part) => `${part.slice(0, 1).toUpperCase()}${part.slice(1)}`)
    .join('');
}

function getPackageImportName(name: BlockName) {
  if (name === 'rocker-thumb-surface') {
    return undefined;
  }

  if (name === 'lcd-display') {
    return 'LCDDisplay';
  }

  return toPascalCase(name);
}

export function getStaticPaths() {
  return getBlockEntries().map((entry) => ({
    params: { name: entry.name },
  }));
}

const entry = getBlockEntry(Astro.params.name ?? '');

if (!entry) {
  throw new Error(`Missing component docs entry for "${Astro.params.name}".`);
}

const navigation = await getDocsNavigation();
const packageImportName = getPackageImportName(entry.name);
const headings = [
  { depth: 2, slug: 'overview', text: 'Overview' },
  { depth: 2, slug: 'installation', text: 'Installation' },
  { depth: 2, slug: 'preview-and-examples', text: 'Preview and examples' },
  { depth: 2, slug: 'dependencies', text: 'Dependencies' },
];
const registryInstallSnippet = `pnpm dlx shadcn@latest add https://analogui.com/r/analog-foundation.json
pnpm dlx shadcn@latest add https://analogui.com${entry.registryHref}`;
const packageImportSnippet = packageImportName
  ? `import "analog-ui/styles.css";
import { ${packageImportName} } from "analog-ui";`
  : undefined;
---

<DocsLayout
  title={entry.title}
  description={entry.description}
  currentPath={getComponentDocHref(entry.name)}
  navigation={navigation}
  headings={headings}
>
  <h2 id="overview">Overview</h2>
  <p>{entry.summary}</p>
  <p>
    {entry.description}
    {' '}
    Use this page for install details and the isolated preview, then jump to{' '}
    <a href={entry.href}>{entry.categoryLabel} blocks</a> when you want examples in context.
  </p>

  <div class="not-prose mt-6 grid gap-3 sm:grid-cols-3">
    <a
      href={entry.href}
      class="rounded-[var(--analog-radius-shell)] border border-white/10 bg-black/30 p-4 transition-colors duration-200 hover:bg-white/[0.05]"
    >
      <div class="micro-label">Block Family</div>
      <div class="mt-2 text-lg font-semibold text-white">{entry.categoryLabel}</div>
      <p class="mt-2 text-sm leading-6 text-[#9f9f9f]">{entry.categoryDescription}</p>
    </a>
    <a
      href={entry.viewHref}
      class="rounded-[var(--analog-radius-shell)] border border-white/10 bg-black/30 p-4 transition-colors duration-200 hover:bg-white/[0.05]"
    >
      <div class="micro-label">Isolated Preview</div>
      <div class="mt-2 text-lg font-semibold text-white">{entry.viewHref}</div>
      <p class="mt-2 text-sm leading-6 text-[#9f9f9f]">
        Open the focused route for screenshots, QA, and single-control review.
      </p>
    </a>
    <a
      href={entry.registryHref}
      class="rounded-[var(--analog-radius-shell)] border border-white/10 bg-black/30 p-4 transition-colors duration-200 hover:bg-white/[0.05]"
    >
      <div class="micro-label">Registry JSON</div>
      <div class="mt-2 text-lg font-semibold text-white">{entry.registryHref}</div>
      <p class="mt-2 text-sm leading-6 text-[#9f9f9f]">
        Pull the component source through the shadcn-compatible registry flow.
      </p>
    </a>
  </div>

  <h2 id="installation">Installation</h2>
  <p>
    Install the shared foundation first so the material tokens and analog lighting variables are
    present, then add the component registry item you need.
  </p>

  <h3>Registry</h3>
  <pre><code>{registryInstallSnippet}</code></pre>

  {
    packageImportSnippet ? (
      <>
        <h3>Package</h3>
        <p>
          If you are consuming the package directly, import the shared stylesheet once and then pull
          the component from the package barrel.
        </p>
        <pre>
          <code>{packageImportSnippet}</code>
        </pre>
      </>
    ) : (
      <blockquote>
        This surface is documented through the registry flow and block examples. It is not currently
        re-exported from the package entrypoint.
      </blockquote>
    )
  }

  <h2 id="preview-and-examples">Preview and examples</h2>
  <p>
    The docs page gives you the install path; the block and view routes give you the visual context.
    Use both when you are evaluating fit, naming, and interaction quality.
  </p>

  <div
    class="not-prose mt-6 rounded-[var(--analog-radius-panel)] border border-white/10 bg-black/35 p-4 md:p-6"
  >
    <BlockDemo name={entry.name} mode="full" client:load />
  </div>

  <div class="not-prose mt-6 flex flex-wrap gap-3">
    <a class="pill-link" href={entry.href}>
      Browse {entry.categoryLabel} Blocks
    </a>
    <a class="pill-link" href={entry.viewHref}> Open Isolated Preview </a>
  </div>

  <h2 id="dependencies">Dependencies</h2>
  <p>
    The registry entry records both package dependencies and registry dependencies so installs stay
    reproducible across host apps.
  </p>

  <div class="not-prose mt-6 grid gap-4 md:grid-cols-2">
    <div class="rounded-[var(--analog-radius-shell)] border border-white/10 bg-black/30 p-4">
      <div class="micro-label">Registry Dependencies</div>
      <div class="mt-4 flex flex-wrap gap-2">
        {
          entry.registryDependencies.length > 0 ? (
            entry.registryDependencies.map((dependency) => (
              <span class="rounded-full border border-white/10 bg-white/[0.04] px-3 py-1 text-xs text-[#d6d6d6]">
                {dependency}
              </span>
            ))
          ) : (
            <span class="text-sm text-[#7c7c7c]">None</span>
          )
        }
      </div>
    </div>

    <div class="rounded-[var(--analog-radius-shell)] border border-white/10 bg-black/30 p-4">
      <div class="micro-label">Package Dependencies</div>
      <div class="mt-4 flex flex-wrap gap-2">
        {
          entry.dependencies.length > 0 ? (
            entry.dependencies.map((dependency) => (
              <span class="rounded-full border border-white/10 bg-white/[0.04] px-3 py-1 text-xs text-[#d6d6d6]">
                {dependency}
              </span>
            ))
          ) : (
            <span class="text-sm text-[#7c7c7c]">None</span>
          )
        }
      </div>
    </div>
  </div>
</DocsLayout>
