---
import BlockDemo from '../../../components/blocks/BlockDemo';
import ComponentDependencyCards from '../../../components/docs/ComponentDependencyCards.astro';
import ComponentInstallCode from '../../../components/docs/ComponentInstallCode.astro';
import ComponentPreview from '../../../components/docs/ComponentPreview.astro';
import DocsCodeBlock from '../../../components/docs/DocsCodeBlock.astro';
import { getComponentPageDoc } from '../../../data/component-docs';
import DocsLayout from '../../../layouts/DocsLayout.astro';
import { getBlockEntries, getBlockEntry } from '../../../lib/blocks';
import { getComponentDocHref, getDocsNavigation } from '../../../lib/docs';
import { getEntry } from 'astro:content';
import { PushButton } from '../../../../../../packages/analog-ui/src/index';

function slugify(value: string) {
  return value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
}

export function getStaticPaths() {
  return getBlockEntries().map((entry) => ({
    params: { name: entry.name },
  }));
}

const entry = getBlockEntry(Astro.params.name ?? '');

if (!entry) {
  throw new Error(`Missing component docs entry for "${Astro.params.name}".`);
}

const navigation = await getDocsNavigation();
const componentDoc = getComponentPageDoc(entry.name);
const componentApiDoc = await getEntry('componentApis', entry.name);

if (!componentApiDoc) {
  throw new Error(`Missing generated component API entry for "${entry.name}".`);
}

const apiSections = componentApiDoc.data.sections;
const compositionHeadings = componentDoc.composition
  ? [
      { depth: 2, slug: 'composition', text: 'Composition' },
      ...(componentDoc.composition.customizeCode
        ? [
            {
              depth: 3,
              slug: 'customization',
              text: componentDoc.composition.customizeTitle ?? 'Customize',
            },
          ]
        : []),
    ]
  : [];
const headings = [
  { depth: 2, slug: 'example', text: 'Live Example' },
  { depth: 2, slug: 'installation', text: 'Installation' },
  { depth: 2, slug: 'usage', text: 'Usage' },
  ...compositionHeadings,
  { depth: 2, slug: 'api-reference', text: 'Props' },
  ...apiSections.map((section) => ({
    depth: 3,
    slug: slugify(section.title),
    text: section.title,
  })),
];
---

<DocsLayout
  title={entry.title}
  description={entry.description}
  currentPath={getComponentDocHref(entry.name)}
  navigation={navigation}
  headings={headings}
>
  <p>{entry.summary}</p>
  <p>
    {entry.description}
    {' '}
    Try it live, then install it through the registry or package API.
  </p>

  <h2 id="example">Live Example</h2>
  <p>Adjust the control below, then use the source as a compact starting point in your app.</p>

  <ComponentPreview
    code={componentDoc.exampleCode}
    title={`${entry.title} Example`}
    description="Interactive preview with a small implementation sample."
    codeLabel="Source"
  >
    <BlockDemo slot="preview" name={entry.name} mode="full" client:load />
  </ComponentPreview>

  <div class="not-prose mt-6 flex flex-wrap gap-3">
    <PushButton client:load href="/docs/components" height="2.5rem" variant="black">
      All Components
    </PushButton>
    <PushButton client:load href={entry.viewHref} height="2.5rem" variant="black">
      Open Isolated Preview
    </PushButton>
  </div>

  <h2 id="installation">Installation</h2>
  <p>
    Install the shared foundation first so the material tokens and analog lighting variables are in
    place, then add this component from the shadcn-compatible registry.
  </p>

  <h3>Registry</h3>
  <ComponentInstallCode registryHref={entry.registryHref} />

  {
    componentDoc.packageImportCode ? (
      <>
        <h3>Package</h3>
        <p>
          If you prefer package imports, install the package and import the shared stylesheet once
          in your app.
        </p>
        <ComponentInstallCode registryHref={entry.registryHref} mode="package" />
      </>
    ) : (
      <blockquote>
        Install this utility through the registry when you need to compose custom Analog UI
        controls.
      </blockquote>
    )
  }

  <h2 id="usage">Usage</h2>
  <p>{componentDoc.usageIntro}</p>

  <h3>Registry import</h3>
  <DocsCodeBlock code={componentDoc.registryImportCode} label="Code" />

  {
    componentDoc.packageImportCode ? (
      <>
        <h3>Package import</h3>
        <DocsCodeBlock code={componentDoc.packageImportCode} label="Code" />
      </>
    ) : null
  }

  <h3>Basic usage</h3>
  <DocsCodeBlock code={componentDoc.usageCode} label="Code" />

  {
    componentDoc.composition ? (
      <>
        <h2 id="composition">Composition</h2>
        <p>{componentDoc.composition.description}</p>
        <DocsCodeBlock code={componentDoc.composition.tree} label="Tree" />
        {componentDoc.composition.customizeCode ? (
          <>
            <h3 id="customization">{componentDoc.composition.customizeTitle ?? 'Customize'}</h3>
            {componentDoc.composition.customizeDescription ? (
              <p>{componentDoc.composition.customizeDescription}</p>
            ) : null}
            <DocsCodeBlock code={componentDoc.composition.customizeCode} label="Code" />
          </>
        ) : null}
      </>
    ) : null
  }

  <h2 id="api-reference">Props</h2>
  <p>
    These tables focus on Analog UI-specific props. Components that wrap Base UI primitives also
    inherit the relevant native and Base UI props for that primitive.
  </p>

  {
    apiSections.map((section) => (
      <>
        <h3 id={slugify(section.title)}>{section.title}</h3>
        <p>{section.description}</p>
        <div class="section-panel not-prose mt-4 overflow-x-auto">
          <table class="w-full min-w-[720px] border-collapse text-left text-sm">
            <thead>
              <tr class="border-b border-white/10 text-[11px] uppercase tracking-[0.2em] text-[#8a8a8a]">
                <th class="px-4 py-3 font-semibold">Prop</th>
                <th class="px-4 py-3 font-semibold">Type</th>
                <th class="px-4 py-3 font-semibold">Default</th>
                <th class="px-4 py-3 font-semibold">Description</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/8">
              {section.props.map((prop) => (
                <tr>
                  <td class="px-4 py-3 align-top font-mono text-[13px] text-white">{prop.name}</td>
                  <td class="px-4 py-3 align-top font-mono text-[13px] text-[#d9d9d9]">
                    {prop.type}
                  </td>
                  <td class="px-4 py-3 align-top font-mono text-[13px] text-[#a8a8a8]">
                    {prop.defaultValue ?? '-'}
                  </td>
                  <td class="px-4 py-3 align-top text-[#b9b9b9]">{prop.description}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    ))
  }

  <h3 id="registry-metadata">Dependencies</h3>
  <p>
    Registry installs include the package and local item dependencies needed for this component.
  </p>

  <ComponentDependencyCards
    class="mt-6"
    registryDependencies={entry.registryDependencies}
    packageDependencies={entry.dependencies}
  />
</DocsLayout>
