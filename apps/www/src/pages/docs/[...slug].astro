---
import { render } from "astro:content";

import DocsLayout from "../../layouts/DocsLayout.astro";
import { getDocBySlug, getDocHref, getDocsEntries, getDocsNavigation } from "../../lib/docs";

export async function getStaticPaths() {
  const entries = await getDocsEntries();

  return entries
    .filter((entry) => entry.slug !== "index")
    .map((entry) => ({
      params: { slug: entry.slug },
    }));
}

const entry = await getDocBySlug(Astro.params.slug);

if (!entry) {
  throw new Error(`Missing doc entry for slug "${Astro.params.slug}".`);
}

const { Content, headings } = await render(entry);
const navigation = await getDocsNavigation();
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  currentPath={getDocHref(entry)}
  navigation={navigation}
  headings={headings}
>
  <Content />
</DocsLayout>
