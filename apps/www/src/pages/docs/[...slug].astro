---
import { render } from 'astro:content';

import ComponentsIndex from '../../components/docs/ComponentsIndex.astro';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { getComponentCategorySections } from '../../lib/components';
import { getDocBySlug, getDocHref, getDocsEntries, getDocsNavigation } from '../../lib/docs';

export async function getStaticPaths() {
  const entries = await getDocsEntries();

  return entries
    .filter((entry) => entry.id !== 'index')
    .map((entry) => ({
      params: { slug: entry.id },
    }));
}

const entry = await getDocBySlug(Astro.params.slug);

if (!entry) {
  throw new Error(`Missing doc entry for slug "${Astro.params.slug}".`);
}

const { Content, headings: renderedHeadings } = await render(entry);
const navigation = await getDocsNavigation();
const isComponentsIndex = entry.id === 'components';
const headings = isComponentsIndex
  ? [
      ...getComponentCategorySections().map((section) => ({
        depth: 2,
        slug: section.category,
        text: section.label,
      })),
      {
        depth: 2,
        slug: 'examples-and-install-commands',
        text: 'Examples And Install Commands',
      },
    ]
  : renderedHeadings;
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  currentPath={getDocHref(entry)}
  navigation={navigation}
  headings={headings}
>
  <Content />
  {isComponentsIndex ? <ComponentsIndex /> : null}
</DocsLayout>
