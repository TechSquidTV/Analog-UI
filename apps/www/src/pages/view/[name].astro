---
import BlockDemo from '../../components/blocks/BlockDemo';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getAllBlockNames, getBlockEntry } from '../../lib/blocks';

export function getStaticPaths() {
  return getAllBlockNames().map((name) => ({
    params: { name },
  }));
}

const entry = getBlockEntry(Astro.params.name ?? '');

if (!entry) {
  throw new Error(`Missing block entry for "${Astro.params.name}".`);
}
---

<SiteLayout title={`${entry.title} Preview`} description={entry.description}>
  <section class="site-frame pt-10 md:pt-12">
    <a
      href={entry.href}
      class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.04] px-4 py-2 text-sm text-[#bdbdbd] transition-colors duration-200 hover:border-white/16 hover:bg-white/[0.08] hover:text-white"
    >
      Back to {entry.categoryLabel}
    </a>

    <div class="mt-6 grid gap-8 lg:grid-cols-[320px_minmax(0,1fr)]">
      <aside class="section-panel h-fit min-w-0 p-5">
        <div class="eyebrow mb-4">{entry.categoryLabel}</div>
        <h1 class="text-3xl font-semibold tracking-[-0.03em] text-white">{entry.title}</h1>
        <p class="mt-3 text-base leading-7 text-[#b0b0b0]">{entry.summary}</p>
        <p class="mt-4 text-sm leading-7 text-[#878787]">{entry.description}</p>

        <div
          class="mt-6 rounded-[var(--analog-radius-shell)] border border-white/10 bg-black/30 p-4"
        >
          <div class="micro-label">Install</div>
          <pre
            class="mt-3 overflow-x-auto text-xs text-[#e0e0e0]"><code>{`pnpm dlx shadcn@latest add https://analogui.com/r/analog-foundation.json
pnpm dlx shadcn@latest add https://analogui.com${entry.registryHref}`}</code></pre>
        </div>

        <div class="mt-6 space-y-4 text-sm text-[#a8a8a8]">
          <div>
            <div class="micro-label mb-2">Registry Type</div>
            <div class="text-white">{entry.registryType}</div>
          </div>

          <div>
            <div class="micro-label mb-2">Registry Dependencies</div>
            <div class="flex flex-wrap gap-2">
              {
                entry.registryDependencies.length > 0 ? (
                  entry.registryDependencies.map((dependency) => (
                    <span class="rounded-full border border-white/10 bg-white/[0.04] px-3 py-1 text-xs text-[#d6d6d6]">
                      {dependency}
                    </span>
                  ))
                ) : (
                  <span class="text-[#7c7c7c]">None</span>
                )
              }
            </div>
          </div>

          <div>
            <div class="micro-label mb-2">Package Dependencies</div>
            <div class="flex flex-wrap gap-2">
              {
                entry.dependencies.length > 0 ? (
                  entry.dependencies.map((dependency) => (
                    <span class="rounded-full border border-white/10 bg-white/[0.04] px-3 py-1 text-xs text-[#d6d6d6]">
                      {dependency}
                    </span>
                  ))
                ) : (
                  <span class="text-[#7c7c7c]">None</span>
                )
              }
            </div>
          </div>
        </div>
      </aside>

      <div class="section-panel min-w-0 overflow-hidden p-5 md:p-8">
        <BlockDemo name={entry.name} mode="full" client:load />
      </div>
    </div>
  </section>
</SiteLayout>
