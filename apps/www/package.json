{
  "name": "analog-ui-www",
  "private": true,
  "version": "0.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TechSquidTV/Analog-UI.git",
    "directory": "apps/www"
  },
  "bugs": {
    "url": "https://github.com/TechSquidTV/Analog-UI/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter analog-ui registry:build && astro dev --host 0.0.0.0 --port 3000",
    "build": "pnpm --filter analog-ui registry:build && astro build",
    "preview": "pnpm --filter analog-ui registry:build && astro preview --host 0.0.0.0 --port 3000",
    "lint": "pnpm run lint:eslint && pnpm run typecheck",
    "lint:eslint": "pnpm exec eslint .",
    "knip": "pnpm -w exec knip --workspace analog-ui-www",
    "format": "pnpm exec prettier --write .",
    "format:check": "pnpm exec prettier --check .",
    "typecheck": "astro check",
    "clean": "rm -rf dist .astro"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.5",
    "@tailwindcss/vite": "^4.1.14",
    "analog-ui": "workspace:*",
    "astro": "^6.3.7",
    "geist": "1.7.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.1.14"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "typescript": "~5.8.2"
  }
}
