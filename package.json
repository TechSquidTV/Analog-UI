{
  "name": "analog-ui-workspace",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TechSquidTV/Analog-UI.git"
  },
  "bugs": {
    "url": "https://github.com/TechSquidTV/Analog-UI/issues"
  },
  "homepage": "https://github.com/TechSquidTV/Analog-UI#readme",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm --filter analog-ui-www dev",
    "dev:all": "turbo run dev --parallel",
    "dev:package": "pnpm --filter analog-ui dev",
    "lint": "pnpm run lint:analog-design && turbo run lint",
    "lint:analog-design": "node tools/eslint-plugin-analog-design/rule-tests.mjs",
    "lint:eslint": "turbo run lint:eslint",
    "registry:build": "pnpm --filter analog-ui registry:build",
    "size:package": "pnpm --filter analog-ui size:package",
    "smoke:package": "pnpm --filter analog-ui smoke:package",
    "treeshake": "pnpm --filter analog-ui treeshake",
    "knip": "pnpm exec knip",
    "format": "pnpm exec prettier --write .",
    "format:check": "pnpm exec prettier --check .",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^10.5.0",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "knip": "^6.16.1",
    "prettier": "^3.8.4",
    "prettier-plugin-astro": "^0.14.1",
    "turbo": "^2.9.18",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.61.0",
    "wrangler": "3.90.0"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
